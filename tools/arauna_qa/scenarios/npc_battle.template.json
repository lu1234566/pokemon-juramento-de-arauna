{
  "name": "replace_with_real_npc_battle",
  "template": true,
  "notes": "Replace MAP_ID and LOCAL_ID with a known trainer/object from the target Arauna build. advance_to_battle only confirms RAM-proven normal TextPrinter waits; menus, Yes/No and unknown waits are never confirmed blindly.",
  "steps": [
    {
      "action": "goto_map",
      "map": "MAP_ID"
    },
    {
      "action": "assert",
      "map": "MAP_ID",
      "in_battle": false
    },
    {
      "action": "talk",
      "local_id": "LOCAL_ID"
    },
    {
      "action": "assert",
      "in_battle": false,
      "script_enabled": true
    },
    {
      "action": "advance_to_battle",
      "max_advances": 16,
      "max_phases": 32,
      "press_frames": 2,
      "wait_frames": 2,
      "settle_frames": 4,
      "stall_cycles": 120
    },
    {
      "action": "assert",
      "in_battle": true
    },
    {
      "action": "screenshot",
      "path": "/tmp/arauna-npc-battle-start.png"
    },
    {
      "action": "play_battle",
      "max_turns": 64,
      "max_cycles": 2048,
      "wait_frames": 4,
      "stall_cycles": 100
    },
    {
      "action": "assert",
      "in_battle": false
    },
    {
      "action": "screenshot",
      "path": "/tmp/arauna-npc-battle-end.png"
    }
  ]
}
