@ The battle every legend shares. VAR_RESULT comes back TRUE when the
@ creature leaves the world (caught or knocked out), FALSE when it stays.
@ VAR_0x8004 keeps the outcome for AraunaLegends_EventScript_Settled.
AraunaLegends_EventScript_Battle::
	setflag FLAG_SYS_CTRL_OBJ_DELETE
	special StartRegiBattle
	clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar VAR_0x8004, GetBattleOutcome
	setvar VAR_RESULT, TRUE
	goto_if_eq VAR_0x8004, B_OUTCOME_CAUGHT, AraunaLegends_EventScript_BattleDone
	goto_if_eq VAR_0x8004, B_OUTCOME_WON, AraunaLegends_EventScript_BattleDone
	setvar VAR_RESULT, FALSE
AraunaLegends_EventScript_BattleDone::
	return

@ Caught: AraunaLegends_OnResume already took the object away before the
@ screen faded back in. Knocked out: it fades now, and wakes again after
@ the next Hall of Fame.
AraunaLegends_EventScript_Settled::
	goto_if_eq VAR_0x8004, B_OUTCOME_CAUGHT, AraunaLegends_EventScript_Remains
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	msgbox AraunaLegends_Text_FadedAway, MSGBOX_DEFAULT
AraunaLegends_EventScript_Remains::
	release
	end

AraunaLegends_Text_FadedAway::
	.string "The presence faded away.\p"
	.string "Perhaps it will return after\n"
	.string "another victory at the LEAGUE.$"

AraunaLegends_Text_Guaraciana::
	.string "A warm light gathers in the dust,\n"
	.string "like the first minutes of morning.$"

AraunaLegends_Text_Tupanau::
	.string "The air tastes of iron.\n"
	.string "Something thunders without a sound.$"

AraunaLegends_Text_Fogareu::
	.string "Embers drift up out of nowhere.\n"
	.string "The stone here is warm to the touch.$"

AraunaLegends_Text_Yasy::
	.string "A pale glow, like moonlight,\n"
	.string "though no window opens here.$"

AraunaLegends_Text_Kuarahy::
	.string "The floor glows gold.\n"
	.string "The oldest sun is watching you.$"

AraunaLegends_Text_Arauanamon::
	.string "The wind stops. The sea goes still.\p"
	.string "Something as old as the land itself\n"
	.string "stands at the foot of the tower.$"

AraunaLegends_Text_Arauanau::
	.string "It is said to appear only when\n"
	.string "the region is in danger.\p"
	.string "It is looking straight at you.$"

AraunaLegends_Text_Terraao::
	.string "Green shoots have pushed up\n"
	.string "through the cave floor here.$"

AraunaLegends_Text_Solzao::
	.string "This heat is not the volcano's.\n"
	.string "The ground is cracked and dry.$"

AraunaLegends_Text_Perybe::
	.string "The water hums with the voices\n"
	.string "of a thousand faraway rivers.$"

AraunaLegends_Text_Iarau::
	.string "A song rises from the water.\n"
	.string "The whole pond holds its breath.$"

AraunaLegends_Text_Verdejante::
	.string "Fresh leaves grow out of old ash\n"
	.string "all around this clearing.$"

AraunaLegends_Text_Poente::
	.string "The sand still holds the colors\n"
	.string "of a sunset long gone.$"

AraunaLegends_Text_Marulho::
	.string "The waves fall into one rhythm,\n"
	.string "as if keeping time for someone.$"

AraunaLegends_Text_Jaciana::
	.string "A silver light, like midnight,\n"
	.string "shines over the shallows.$"

AraunaLegends_Text_Chuvao::
	.string "Rain falls on this islet alone.\n"
	.string "The cloud above it has eyes.$"

AraunaLegends_Text_Rudarauna::
	.string "A gentle warmth drifts over\n"
	.string "the water, like a held hand.$"

AraunaLegends_Text_Boitata::
	.string "Two coals glow in the ash.\n"
	.string "They are eyes. They are watching.$"

AraunaLegends_Text_Ventania::
	.string "A cold south wind whistles\n"
	.string "a tune no one ever taught it.$"

AraunaLegends_Text_Sacinho::
	.string "A small whirlwind spins in place.\n"
	.string "It sounds like someone giggling.$"
