@ Traducao parcial do arco de Porto das Redes.
@ A primeira versao jogavel e inglesa; este arquivo cobre, por enquanto,
@ apenas a cena M15 (a ligacao para Dona Zila).
@ M15 - a ligacao para Dona Zila. A pergunta sobre o mar; a resposta e guardada
@ palavra por palavra e volta no radio do pos-jogo.

AraunaPorto_Text_ZilaCallIntro::
	.string "A linha chia duas vezes antes\n"
	.string "de ela atender.\p"
	.string "DONA ZILA: Ali está você.\p"
	.string "Não, não me fala da insígnia\n"
	.string "ainda. Fala da outra coisa.\p"
	.string "Como é o mar?$"

AraunaPorto_Text_SeaPromptDistance::
	.string "Dizer que parece não acabar?$"

AraunaPorto_Text_SeaDistance::
	.string "Você diz que o mar parece uma\n"
	.string "estrada tão larga que\l"
	.string "esqueceram de construir a\l"
	.string "outra margem.\p"
	.string "DONA ZILA: ...Repete mais\n"
	.string "devagar. Quero guardar.$"

AraunaPorto_Text_SeaPromptSound::
	.string "Dizer que faz muito barulho?$"

AraunaPorto_Text_SeaSound::
	.string "Você diz que, mesmo quando\n"
	.string "ninguém fala, o mar continua\l"
	.string "conversando com tudo ao\l"
	.string "redor.\p"
	.string "DONA ZILA: Então ele é que\n"
	.string "nem a tua avó.$"

AraunaPorto_Text_SeaPromptDark::
	.string "Dizer que à noite dá medo?$"

AraunaPorto_Text_SeaDark::
	.string "Você diz que à noite ele fica\n"
	.string "preto, mas cada barco acende\l"
	.string "uma luz pequena e insiste em\l"
	.string "voltar.\p"
	.string "DONA ZILA: Bom.\p"
	.string "Seja um dos que insistem.$"

AraunaPorto_Text_SeaSilent::
	.string "Você não acha as palavras.\p"
	.string "DONA ZILA: Tudo bem.\n"
	.string "O mar continua lá.\l"
	.string "Me liga quando achar.$"

AraunaPorto_Text_DonaCelinaRoadNorth::
	.string "CELINA: O rio lembra.\p"
	.string "Sua próxima estrada sobe para\n"
	.string "o norte, passa a pedreira e só\l"
	.string "termina na SERRA DO UIVO.\p"
	.string "Caminhe até lá. Quem é levado\n"
	.string "chega sem ter aprendido nada.$"
