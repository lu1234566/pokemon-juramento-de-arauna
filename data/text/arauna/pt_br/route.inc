AraunaMistRoute_Text_NotebookOffer::
	.string "Perdi meu caderno de campo\n"
	.string "perto da neblina densa.\p"
	.string "Pode procurar por ele?$"

AraunaMistRoute_Text_NotebookAccepted::
	.string "A capa tem o desenho de uma\n"
	.string "gralha-azul e um pinhão.$"

AraunaMistRoute_Text_NotebookDeclined::
	.string "Tudo bem. Não saia da trilha\n"
	.string "só por causa do caderno.$"

AraunaMistRoute_Text_NotebookReminder::
	.string "O caderno caiu perto de pedras\n"
	.string "onde a névoa fica mais fria.$"

AraunaMistRoute_Text_NotebookFound::
	.string "Você encontrou um CADERNO\n"
	.string "DE CAMPO molhado.\p"
	.string "A capa mostra uma gralha-azul\n"
	.string "carregando um pinhão.$"

AraunaMistRoute_Text_NotebookReturned::
	.string "Estas anotações levaram meses.\p"
	.string "Receba esta SUPER POTION\n"
	.string "e volte em segurança.$"

AraunaMistRoute_Text_RewardBagFull::
	.string "Sua MOCHILA está cheia.\n"
	.string "Volte quando houver espaço.$"

AraunaMistRoute_Text_NotebookThanks::
	.string "A neblina apaga rastros, mas\n"
	.string "você recuperou minha memória.$"

AraunaMistRoute_Text_AffectedPokemon::
	.string "O POOCHYENA treme diante de\n"
	.string "um pulso vindo das ruínas.\p"
	.string "Ele é um placeholder técnico\n"
	.string "para o encontro afetado.$"

AraunaMistRoute_Text_RuinOpened::
	.string "O POKéMON foge para o norte.\p"
	.string "Por um instante, símbolos\n"
	.string "brilham na entrada da ruína.$"

AraunaMistRoute_Text_TracksToRuin::
	.string "Pegadas recentes seguem até\n"
	.string "a entrada da ruína.$"

AraunaMistRoute_Text_RuinBlocked::
	.string "Um selo frio cobre a passagem.\p"
	.string "O POKéMON afetado ainda está\n"
	.string "escondido perto da entrada.$"
