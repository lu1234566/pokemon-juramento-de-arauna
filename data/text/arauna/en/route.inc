AraunaMistRoute_Text_NotebookOffer::
	.string "I lost my field notebook near\n"
	.string "the deepest mist.\p"
	.string "Could you look for it?$"

AraunaMistRoute_Text_NotebookAccepted::
	.string "Its cover shows an azure jay\n"
	.string "carrying a pine seed.$"

AraunaMistRoute_Text_NotebookDeclined::
	.string "All right. Do not leave the\n"
	.string "trail just for the notebook.$"

AraunaMistRoute_Text_NotebookReminder::
	.string "It fell near some stones where\n"
	.string "the mist becomes colder.$"

AraunaMistRoute_Text_NotebookFound::
	.string "You found a wet FIELD\n"
	.string "NOTEBOOK.\p"
	.string "Its cover shows an azure jay\n"
	.string "carrying a pine seed.$"

AraunaMistRoute_Text_NotebookReturned::
	.string "These notes took months.\p"
	.string "Take this SUPER POTION and\n"
	.string "return safely.$"

AraunaMistRoute_Text_RewardBagFull::
	.string "Your BAG is full.\n"
	.string "Return when you have space.$"

AraunaMistRoute_Text_NotebookThanks::
	.string "The mist erases tracks, but\n"
	.string "you recovered my memories.$"

AraunaMistRoute_Text_AffectedPokemon::
	.string "The grass ahead loses its color.\p"
	.string "A small shape trembles as a\n"
	.string "pulse rolls down from the stones.\p"
	.string "Before you can focus on it, the\n"
	.string "shape slips into the mist.$"

AraunaMistRoute_Text_SurveyReady::
	.string "The shape vanishes north, but a\n"
	.string "strip of grass stays gray.\p"
	.string "The notebook now holds something\n"
	.string "CIRO and ANAHI need to see.$"

AraunaMistRoute_Text_SurveyBlocked::
	.string "The mist thickens ahead.\p"
	.string "ANAHI asked for direct evidence.\n"
	.string "Search nearby before ending the\n"
	.string "survey.$"

AraunaMistRoute_Text_SurveyComplete::
	.string "At the ridge, the gray trail\n"
	.string "turns toward VILA AMANHECER.\p"
	.string "You mark the place in ZILA's\n"
	.string "notebook and return to CIRO.$"

AraunaMistRoute_Text_CoastRoad::
	.string "Beyond the ridge, the mist opens\n"
	.string "onto the old COAST ROAD.\p"
	.string "PORTO DAS REDES lies south.\n"
	.string "You continue on foot.$"

Route110_Text_CoastRoadArrival::
	.string "OLD COAST ROAD\p"
	.string "Salt wind reaches this far\n"
	.string "inland, but the water below has\n"
	.string "lost its blue.\p"
	.string "ZILA'S NOTEBOOK marks PORTO DAS\n"
	.string "REDES at the southern end.$"

Route110_Text_CoastRoadReturn::
	.string "The old road still descends\n"
	.string "toward PORTO DAS REDES.$"

Route110_Text_NorthRoadBlocked::
	.string "A work crew and a CONSORTIUM\n"
	.string "checkpoint seal the northern\n"
	.string "road.\p"
	.string "The only open direction is\n"
	.string "toward PORTO.$"

Route110_Text_NorthRoadWorker::
	.string "WORKER: The hillside shifted\n"
	.string "during the last pale tide.\p"
	.string "Nobody passes north until the\n"
	.string "supports are replaced.$"

Route110_Text_NorthRoadWorkerOpen::
	.string "WORKER: The supports are sound.\n"
	.string "The inland road is open again.$"

Route110_Text_ConsortiumCheckpoint::
	.string "CONSORTIUM AGENT: Restricted\n"
	.string "maintenance corridor.\p"
	.string "Authorization from PORTO is not\n"
	.string "valid beyond this point.$"

Route110_Text_ConsortiumCheckpointOpen::
	.string "The checkpoint has been\n"
	.string "abandoned. Its seals are torn.$"

Route110_Text_PortoGuide::
	.string "The lamps ahead belong to\n"
	.string "PORTO DAS REDES.\p"
	.string "Follow the road until the air\n"
	.string "smells of rope and wet wood.$"

Route110_Text_Fisher::
	.string "The fish used to follow this\n"
	.string "channel inland.\p"
	.string "Now even the birds refuse to\n"
	.string "circle above it.$"

Route110_Text_Migrant::
	.string "Families from the shore sleep\n"
	.string "under these old shelters.\p"
	.string "They say the CONSORTIUM calls\n"
	.string "displacement a safety measure.$"

Route110_Text_Mechanic::
	.string "The old transport rails still\n"
	.string "work, but the checkpoint keeps\n"
	.string "them locked.\p"
	.string "Walking is slower. It is also\n"
	.string "harder to control.$"

Route110_Text_Courier::
	.string "Every sealed crate going north\n"
	.string "carries water samples.\p"
	.string "Every empty crate returns\n"
	.string "without a manifest.$"

Route110_Text_PortoSign::
	.string "SOUTH: PORTO DAS REDES\n"
	.string "FISHING HARBOR AND TIDE HOUSES$"

Route110_Text_NorthClosureSign::
	.string "NORTH ROAD CLOSED\p"
	.string "LANDSLIDE REPAIR AND CONSORTIUM\n"
	.string "INSPECTION IN PROGRESS$"

Route110_Text_OldCheckpointSign::
	.string "An old toll sign has been\n"
	.string "covered by a CONSORTIUM permit\n"
	.string "notice.$"

Route110_Text_FieldStationSign::
	.string "COASTAL FIELD STATION\p"
	.string "CLOSED AFTER WATER QUALITY\n"
	.string "INCIDENT$"

Route110_Text_ConsortiumFenceSign::
	.string "PRIVATE EXTRACTION CORRIDOR\p"
	.string "TRESPASSERS WILL BE RECORDED$"
