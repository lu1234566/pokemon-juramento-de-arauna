AraunaMistRoute_Text_NotebookOffer::
	.string "I lost my field notebook near\n"
	.string "the deepest mist.\p"
	.string "Could you look for it?$"

AraunaMistRoute_Text_NotebookAccepted::
	.string "Its cover shows an azure jay\n"
	.string "carrying a pine seed.$"

AraunaMistRoute_Text_NotebookDeclined::
	.string "All right. Do not leave the\n"
	.string "trail just for the notebook.$"

AraunaMistRoute_Text_NotebookReminder::
	.string "It fell near some stones where\n"
	.string "the mist becomes colder.$"

AraunaMistRoute_Text_NotebookFound::
	.string "You found a wet FIELD\n"
	.string "NOTEBOOK.\p"
	.string "Its cover shows an azure jay\n"
	.string "carrying a pine seed.$"

AraunaMistRoute_Text_NotebookReturned::
	.string "These notes took months.\p"
	.string "Take this SUPER POTION and\n"
	.string "return safely.$"

AraunaMistRoute_Text_RewardBagFull::
	.string "Your BAG is full.\n"
	.string "Return when you have space.$"

AraunaMistRoute_Text_NotebookThanks::
	.string "The mist erases tracks, but\n"
	.string "you recovered my memories.$"

AraunaMistRoute_Text_AffectedPokemon::
	.string "The grass ahead loses its color.\p"
	.string "A small shape trembles as a\n"
	.string "pulse rolls down from the stones.\p"
	.string "Before you can focus on it, the\n"
	.string "shape slips into the mist.$"

AraunaMistRoute_Text_SurveyReady::
	.string "The shape vanishes north, but a\n"
	.string "strip of grass stays gray.\p"
	.string "The notebook now holds something\n"
	.string "CIRO and ANAHI need to see.$"

AraunaMistRoute_Text_SurveyBlocked::
	.string "The mist thickens ahead.\p"
	.string "ANAHI asked for direct evidence.\n"
	.string "Search nearby before ending the\n"
	.string "survey.$"

AraunaMistRoute_Text_SurveyComplete::
	.string "At the ridge, the gray trail\n"
	.string "turns toward VILA AMANHECER.\p"
	.string "You mark the place in ZILA's\n"
	.string "notebook and return to CIRO.$"

AraunaMistRoute_Text_CoastRoad::
	.string "Beyond the ridge, the mist opens\n"
	.string "onto the old COAST ROAD.\p"
	.string "PORTO DAS REDES lies south.\n"
	.string "You continue on foot.$"
