    ],
    "MauvilleCity_Text_BikeShopSign": [
      "ENCRUZILHADA CYCLES\\p",
      "Two bikes. Two kinds of road.$"
    ],
    "MauvilleCity_Text_GameCornerSign": [
      "ENCRUZILHADA GAME HALL\\p",
      "Lights, games and prizes.$"
    ],
    "MauvilleCity_Text_ExplainTV": [
      "Do you watch local TV?\\p",
      "News from all four roads reaches\\n",
      "this city first.$"
    ],
    "MauvilleCity_Text_BeenCheckingOutTV": [
      "I've watched the broadcasts.\\p",
      "One event, three interviews,\\n",
      "three different stories.$"
    ]
  },
  "gym": {
