    ],
    "MauvilleCity_Gym_Text_BenDefeat": [
      "You found the clean path.$"
    ],
    "MauvilleCity_Gym_Text_BenPostBattle": [
      "The puzzle isn't a trap.\\p",
      "It's practice reading a network.$"
    ],
    "MauvilleCity_Gym_Text_VivianIntro": [
      "A spark can cross a tiny gap.\\p",
