    "gText_AnabelDefeatGold": ["You did not chase the pattern.", "You changed it.$"],

    "gText_TuckerWonSilver": ["A crowd changes pressure,", "not the result.$"],
    "gText_TuckerDefeatSilver": ["You held your plan under noise.", "Well done.$"],
    "gText_TuckerWonGold": ["A bracket rewards timing,", "not just force.$"],
    "gText_TuckerDefeatGold": ["Every round answered", "the one before it.$"],

    "gText_NolandWonSilver": ["Borrowed teams expose habits.$"],
    "gText_NolandDefeatSilver": ["You learned strangers quickly.$"],
