{
  "corp1": {
    "RustboroCity_DevonCorp_1F_Text_WelcomeToDevonCorp": [
      "Welcome to the HORIZON\\n",
      "TECHNICAL CENTER.\\p",
      "This floor is open to visitors.$"
    ],
    "RustboroCity_DevonCorp_1F_Text_StaffGotRobbed": [
      "A field shipment was stolen.\\p",
      "The OCEANIC PARTS were due in\\n",
      "PORTO DO SAL.$"
    ],
    "RustboroCity_DevonCorp_1F_Text_ThoseShoesAreOurProduct": [
      "Those RUNNING SHOES use our\\n",
      "field sole design.\\p",
      "Nice to see them outside a lab.$"
    ],
    "RustboroCity_DevonCorp_1F_Text_RobberWasntVeryBright": [
      "The stolen parts are calibrated.\\p",
      "Without their key, the thief\\n",
      "can't use them safely.$"
    ],
    "RustboroCity_DevonCorp_1F_Text_SoundsLikeStolenGoodsRecovered": [
      "OCEANIC PARTS recovered.\\p",
      "PORTO DO SAL stays on schedule.$"
    ],
    "RustboroCity_DevonCorp_1F_Text_OnlyAuthorizedPeopleEnter": [
      "Research floors require\\n",
      "authorization.$"
    ],
    "RustboroCity_DevonCorp_1F_Text_HowCouldWeGetRobbed": [
      "We logged every crate.\\p",
      "We still failed to protect one.$"
    ],
    "RustboroCity_DevonCorp_1F_Text_YoureAlwaysWelcomeHere": [
      "You're cleared to visit.\\p",
      "Thanks for recovering the parts.$"
    ],
    "RustboroCity_DevonCorp_1F_Text_RocksMetalDisplay": [
      "Quarry stone and metal samples\\n",
      "fill the case.\\p",
      "HORIZON began with roads, mines\\n",
      "and rescue engineering.\\p",
      "BOND research came much later.$"
    ],
    "RustboroCity_DevonCorp_1F_Text_ProductDisplay": [
      "Field tools fill the case.\\p",
      "Boot soles. POKé BALL parts.\\p",
      "Survey gear. POKéNAV modules.\\p",
      "Useful work built HORIZON's\\n",
      "reputation before BOND research.$"
    ]
  },
  "corp2": {
    "RustboroCity_DevonCorp_2F_Text_DeviceForTalkingToPokemon": [
      "We test signals POKéMON use to\\n",
