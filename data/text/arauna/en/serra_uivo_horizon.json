      "Good tools outlive bad uses.$"
    ],
    "RustboroCity_DevonCorp_2F_Text_DeviceToVisualizePokemonDreams": [
      "Our dream imaging test worked.\\p",
      "The consent protocol did not.\\p",
      "So the project is paused.$"
    ],
    "RustboroCity_DevonCorp_2F_Text_DevelopDeviceToResurrectFossils": [
      "My FOSSIL REGENERATOR may\\n",
      "restore ancient POKéMON.\\p",
      "This project is working.$"
    ],
    "RustboroCity_DevonCorp_2F_Text_WantToBringFossilBackToLife": [
      "That's a POKéMON fossil.\\p",
      "Want me to regenerate it here?$"
    ],
    "RustboroCity_DevonCorp_2F_Text_OhIsThatSo": [
      "No problem.\\p",
      "The fossil remains yours.$"
    ],
    "RustboroCity_DevonCorp_2F_Text_TwoFossilsPickOne": [
      "You have two fossils.\\p",
