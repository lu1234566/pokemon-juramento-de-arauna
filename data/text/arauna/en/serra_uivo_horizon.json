  "corp3": {
    "RustboroCity_DevonCorp_3F_Text_MrStoneIHaveFavor": [
      "OTACILIO: I'm Otacilio Meira.\\p",
      "You recovered our OCEANIC PARTS.\\p",
      "They still need to reach\\n",
      "PORTO DO SAL.\\p",
      "I need this LETTER delivered\\n",
      "to SEU BENTO in PORTO DAS REDES.\\p",
      "He sees what instruments miss.$"
    ],
    "RustboroCity_DevonCorp_3F_Text_MrStoneWantYouToHaveThis": [
      "OTACILIO: A favor must not hide\\n",
      "its cost.\\p",
      "Take this for the road.$"
    ],
    "RustboroCity_DevonCorp_3F_Text_ReceivedPokenav": [
      "{PLAYER} received a POKéNAV.$"
    ],
    "RustboroCity_DevonCorp_3F_Text_MrStoneExplainPokenavRestUp": [
      "OTACILIO: POKéNAV maps ARAUNA\\n",
      "and keeps field contacts.\\p",
      "HORIZON works at a scale where\\n",
      "mistakes become expensive.\\p",
      "Urgency is not permission.\\p",
      "Rest before you travel.$"
    ],
    "RustboroCity_DevonCorp_3F_Text_MrStoneGoWithCautionAndCare": [
      "OTACILIO: Travel carefully,\\n",
      "{PLAYER}.$"
    ],
    "RustboroCity_DevonCorp_3F_Text_CountingOnYou": [
      "OTACILIO: I'm counting on you.$"
    ],
    "RustboroCity_DevonCorp_3F_Text_ThankYouForDeliveringLetter": [
      "OTACILIO: BENTO got my LETTER.\\p",
      "If he disagreed, keep his\\n",
      "objections in your notes.\\p",
      "Take this as thanks.$"
    ],
    "RustboroCity_DevonCorp_3F_Text_ExplainExpShare": [
      "OTACILIO: EXP. SHARE can help\\n",
      "a POKéMON gain EXP safely.\\p",
      "It gains EXP without battling.\\p",
      "Useful while a partner finds\\n",
      "its footing.$"
    ],
    "RustboroCity_DevonCorp_3F_Text_NotFamiliarWithTrends": [
      "OTACILIO: Institutions get old\\n",
