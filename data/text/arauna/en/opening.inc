AraunaPlayerHouse_Text_WakeUp::
	.string "The mist covered town early.\p"
	.string "DR. MAIA asked you to visit\n"
	.string "the RESEARCH CENTER.$"

AraunaPlayerHouse_Text_CenterReminder::
	.string "DR. MAIA sounded worried.\p"
	.string "Visit the CENTER before\n"
	.string "heading into the woods.$"

AraunaPlayerHouse_Text_ResponsibleAfterCall::
	.string "Be careful in the mist.\n"
	.string "It muffles even nearby steps.$"

AraunaResearchCenter_Text_BeforeCall::
	.string "DR. MAIA is still preparing\n"
	.string "the research program.$"

AraunaResearchCenter_Text_MaiaIntroduction::
	.string "Right on time, {PLAYER}.\p"
	.string "Three POKéMON reacted to a\n"
	.string "pulse from the woods.\p"
	.string "Study each sphere. Choose only\n"
	.string "when you are certain.$"

AraunaResearchCenter_Text_AfterChoice::
	.string "NILO is waiting in the plaza.\p"
	.string "He will test your preparation\n"
	.string "before opening the route.$"

AraunaResearchCenter_Text_RouteOpen::
	.string "The eastern road is open.\p"
	.string "Record everything the mist\n"
	.string "tries to hide.$"

AraunaResearchCenter_Text_PicaPauPrompt::
	.string "WOODPECKER PROJECT: GRASS.\p"
	.string "Uses wood and stone to\n"
	.string "control the terrain.\p"
	.string "Choose it as your partner?$"

AraunaResearchCenter_Text_CarameloPrompt::
	.string "CARAMELO PROJECT: FIRE.\p"
	.string "A protective dog that will\n"
	.string "one day reach FIRE/DRAGON.\p"
	.string "Choose it as your partner?$"

AraunaResearchCenter_Text_QueroQueroPrompt::
	.string "LAPWING PROJECT: WATER.\p"
	.string "Fast and territorial; it will\n"
	.string "one day reach WATER/BUG.\p"
	.string "Choose it as your partner?$"

AraunaResearchCenter_Text_PlaceholderNotice::
	.string "Partner registered.\p"
	.string "The POKéMON shown now is a\n"
	.string "technical placeholder.\p"
	.string "No ARAUNA sprite was added\n"
	.string "without approval.$"

AraunaResearchCenter_Text_SelectionLocked::
	.string "Wait for DR. MAIA's call before\n"
	.string "touching the spheres.$"

AraunaResearchCenter_Text_AlreadyChosen::
	.string "Your choice is already logged.\n"
	.string "The other spheres are sealed.$"

AraunaResearchCenter_Text_ChoiceCancelled::
	.string "The sphere becomes still.\n"
	.string "You can keep observing.$"

AraunaMapLab_Text_ObjectiveHome::
	.string "Your home is to the northwest.\n"
	.string "Go inside to receive the call.$"

AraunaMapLab_Text_ObjectiveCenter::
	.string "DR. MAIA awaits at the RESEARCH\n"
	.string "CENTER, to the northeast.$"

AraunaMapLab_Text_ObjectiveNilo::
	.string "NILO is waiting in the plaza.\n"
	.string "He wants to test your skills.$"

AraunaMapLab_Text_ObjectiveRoute::
	.string "The MIST ROUTE is open through\n"
	.string "the eastern road.$"

AraunaMapLab_Text_NiloAfterBattle::
	.string "The route is open.\p"
	.string "Do not mistake silence for\n"
	.string "safety.$"

AraunaMapLab_Text_RouteLocked::
	.string "NILO blocked the exit.\p"
	.string "Choose a partner at the CENTER\n"
	.string "and meet him in the plaza.$"
