AraunaFirstLinkChamber_Text_AgentIntro::
	.string "AGENT: Step away from the seal.\p"
	.string "The League calls this a ruin.\n"
	.string "We call it containment.\p"
	.string "You will not take that memory.$"

AraunaFirstLinkChamber_Text_SigilHealsParty::
	.string "The seal pulses before battle.\p"
	.string "Your team is fully restored.$"

AraunaFirstLinkChamber_Text_AgentDefeat::
	.string "That was outside the protocol!$"

AraunaFirstLinkChamber_Text_AgentAfterBattle::
	.string "AGENT: The seal answered you.\p"
	.string "That should be impossible.$"

AraunaFirstLinkChamber_Text_GuardianPresence::
	.string "The whole chamber trembles.\p"
	.string "For an instant, a colossal\n"
	.string "presence covers the walls.\p"
	.string "It has no complete form.$"

AraunaFirstLinkChamber_Text_ChampionMemory::
	.string "A memory floods the old seal.\p"
	.string "A CHAMPION's shadow raises a\n"
	.string "hand against the Bond itself.\p"
	.string "CHAMPION: Forgive me.\n"
	.string "It was the only way.\p"
	.string "The image ends. He was alive.$"

AraunaFirstLinkChamber_Text_CourageMemory::
	.string "The presence recalls your act.\p"
	.string "You advanced when the stone\n"
	.string "told you to retreat.$"

AraunaFirstLinkChamber_Text_WisdomMemory::
	.string "The presence recalls your act.\p"
	.string "You heard the mechanism before\n"
	.string "demanding an answer.$"

AraunaFirstLinkChamber_Text_CompassionMemory::
	.string "The presence recalls your act.\p"
	.string "You calmed fear before\n"
	.string "searching for an answer.$"

AraunaFirstLinkChamber_Text_CourageReward::
	.string "The fragment answers COURAGE.\p"
	.string "Its energy favors action.$"

AraunaFirstLinkChamber_Text_WisdomReward::
	.string "The fragment answers WISDOM.\p"
	.string "Its energy favors focus.$"

AraunaFirstLinkChamber_Text_CompassionReward::
	.string "The fragment answers\n"
	.string "COMPASSION.\p"
	.string "Its energy favors protection.$"

AraunaFirstLinkChamber_Text_AgentRetreats::
	.string "AGENT: They need to know.\p"
	.string "The CHAMPION still exists in\n"
	.string "these memories.\p"
	.string "The agent flees into the dark.$"

AraunaFirstLinkChamber_Text_RewardBagFull::
	.string "The fragment tries to take form,\n"
	.string "but your Bag is full.\p"
	.string "Speak to the agent after making\n"
	.string "room to finish the scene.$"

AraunaFirstLinkChamber_Text_AfterSlice::
	.string "The seal is silent now.\p"
	.string "The CHAMPION's memory remains.$"
