AraunaResearchCenter_MapScripts::
	.byte 0

AraunaResearchCenter_EventScript_Maia::
	lock
	faceplayer
	goto_if_eq VAR_ARAUNA_STARTER_CHOICE, 0, AraunaResearchCenter_EventScript_BeforeChoice
	goto_if_eq VAR_ARAUNA_STORY_STAGE, 2, AraunaResearchCenter_EventScript_AfterChoice
	goto AraunaResearchCenter_EventScript_RouteOpen

AraunaResearchCenter_EventScript_BeforeChoice::
	msgbox AraunaResearchCenter_Text_BeforeCall, MSGBOX_DEFAULT
	release
	end

AraunaResearchCenter_EventScript_AfterChoice::
	special HealPlayerParty
	call AraunaResearchCenter_EventScript_GiveSecondTestCandies
	msgbox AraunaResearchCenter_Text_AfterChoice, MSGBOX_DEFAULT
	release
	end

AraunaResearchCenter_EventScript_RouteOpen::
	special HealPlayerParty
	call AraunaResearchCenter_EventScript_GiveSecondTestCandies
	msgbox AraunaResearchCenter_Text_RouteOpen, MSGBOX_DEFAULT
	release
	end

AraunaResearchCenter_EventScript_PicaPau::
	lock
	faceplayer
	goto AraunaResearchCenter_EventScript_StarterDisplay

AraunaResearchCenter_EventScript_Caramelo::
	lock
	faceplayer
	goto AraunaResearchCenter_EventScript_StarterDisplay

AraunaResearchCenter_EventScript_QueroQuero::
	lock
	faceplayer
	goto AraunaResearchCenter_EventScript_StarterDisplay

AraunaResearchCenter_EventScript_StarterDisplay::
	goto_if_eq VAR_ARAUNA_STARTER_CHOICE, 0, AraunaResearchCenter_EventScript_SelectionMovedHome
	msgbox AraunaResearchCenter_Text_AlreadyChosen, MSGBOX_DEFAULT
	release
	end

AraunaResearchCenter_EventScript_SelectionMovedHome::
	msgbox AraunaResearchCenter_Text_SelectionLocked, MSGBOX_DEFAULT
	release
	end

AraunaResearchCenter_EventScript_GiveSecondTestCandies::
	goto_if_set FLAG_ARAUNA_SECOND_TEST_CANDIES_RECEIVED, AraunaResearchCenter_EventScript_TestCandiesReturn
	checkitemspace ITEM_RARE_CANDY, 999
	goto_if_eq VAR_RESULT, FALSE, AraunaResearchCenter_EventScript_TestCandiesBagFull
	giveitem ITEM_RARE_CANDY, 999
	goto_if_eq VAR_RESULT, FALSE, AraunaResearchCenter_EventScript_TestCandiesBagFull
	setflag FLAG_ARAUNA_SECOND_TEST_CANDIES_RECEIVED
	msgbox AraunaSecondTest_Text_RareCandiesReceived, MSGBOX_DEFAULT
AraunaResearchCenter_EventScript_TestCandiesReturn::
	return

AraunaResearchCenter_EventScript_TestCandiesBagFull::
	msgbox AraunaSecondTest_Text_RareCandiesBagFull, MSGBOX_DEFAULT
	return
